<!-- JAVASCRIPT ETKİLEŞİM VE MOTORU -->
<!-- ======================================================== -->
<script>
    // 1. SEKME DEĞİŞTİRME MANTIĞI
    function switchTab(tabId) {
      document.querySelectorAll('.page-tab').forEach(el => el.classList.remove('active'));
      const target = document.getElementById('tab-' + tabId);
      if (target) target.classList.add('active');

      const tabs = ['home', 'vision', 'manifest', 'goals', 'settings'];
      const index = tabs.indexOf(tabId);
      document.querySelectorAll('.nav-btn').forEach((btn, i) => {
        if (i === index) {
          btn.className = 'nav-btn flex-1 py-2 rounded-full flex flex-col items-center gap-0.5 text-gold bg-gold/20 active:scale-95 transition-all';
        } else {
          btn.className = 'nav-btn flex-1 py-2 rounded-full flex flex-col items-center gap-0.5 text-stardust hover:text-white active:scale-95 transition-all';
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 2. ANA SAYFA GÖREV TAMAMLAMA
    let homeDone = false;
    function toggleHomeAction() {
      homeDone = !homeDone;
      const btn = document.getElementById('home-check-btn');
      const text = document.getElementById('home-action-text');
      const streak = document.getElementById('home-streak-count');

      if (homeDone) {
        btn.innerHTML = '<span class="material-symbols-outlined text-xl text-teal">check_circle</span>';
        btn.classList.add('border-teal', 'bg-teal/20');
        text.innerText = 'Görev tamamlandı! Bugün vizyonuna yaklaştın ✨';
        streak.innerText = '15';
      } else {
        btn.innerHTML = '<span class="material-symbols-outlined text-xl">radio_button_unchecked</span>';
        btn.classList.remove('border-teal', 'bg-teal/20');
        text.innerText = 'Vize portföyünden 1 ilham yazısı oku.';
        streak.innerText = '14';
      }
    }

    // 3. MİKRO-EYLEM MODALI
    function openCardAction(title, cat, action) {
      document.getElementById('modal-title').innerText = title;
      document.getElementById('modal-cat').innerText = cat;
      document.getElementById('modal-action').innerText = action;
      document.getElementById('action-modal').classList.remove('hidden');
      document.getElementById('action-modal').classList.add('flex');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
    }

    function shrinkModalAction() {
      document.getElementById('modal-action').innerText = '⚡ 5 Dakikalık Mikro-Adım: Sadece vize dosyasının ilk sayfasını aç ve başlığı oku.';
    }

    function completeModalAction() {
      closeModal('action-modal');
      alert('Tebrikler! 15 dakikalık göreviniz kaydedildi ve seriniz güncellendi ✨');
    }

    // 4. SES ÇALAR MOTORU (WEB AUDIO SİNÜS DALGASI)
    let audioCtx = null;
    let osc = null;
    let isPlaying = false;

    function toggleAudio() {
      const btn = document.getElementById('audio-play-btn');
      const disc = document.getElementById('player-disc');

      if (!isPlaying) {
        try {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(432, audioCtx.currentTime); // Gerçek 432Hz matematiksel ton
          gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
        } catch(e) {}

        isPlaying = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-3xl font-bold">pause</span>';
        disc.classList.add('rotate-45');
      } else {
        if (osc) {
          try { osc.stop(); } catch(e) {}
        }
        isPlaying = false;
        btn.innerHTML = '<span class="material-symbols-outlined text-3xl font-bold">play_arrow</span>';
        disc.classList.remove('rotate-45');
      }
    }

    function seekAudio(sec) {
      alert((sec > 0 ? '+10' : '-10') + ' saniye atlandı');
    }

    // 5. ÜCRETSİZ AI KOÇ CEVAP MOTORU
    function sendAiMessage() {
      const input = document.getElementById('ai-user-input');
      const logs = document.getElementById('ai-chat-logs');
      const val = input.value.trim();
      if (!val) return;

      logs.innerHTML += `<div class="p-2.5 rounded-xl bg-violet/30 text-white ml-8 text-right">${val}</div>`;
      input.value = '';

      setTimeout(() => {
        let reply = "Zihnini duyuyorum. Bu büyük niyetini 90 günlük bir SMART kilometre taşına böldüm: Portföyünü tamamla ve haftada 2 uluslararası temas kur. Bugünkü 15 dakikalık tek görevin: En güçlü çalışmanı seçip 3 cümlelik özetini yaz.";
        if (val.toLowerCase().includes('yorgun') || val.toLowerCase().includes('üşen')) {
          reply = "⚡ Zihninin yorgunluğunu şefkatle karşılıyorum. Görevi 5 dakikaya indirdim: Sadece defterini aç ve tek bir cümle yaz. 5 dakika sonra durmakta özgürsün.";
        }
        logs.innerHTML += `<div class="p-3 rounded-2xl bg-surface-container border border-white/5 text-stardust leading-relaxed mr-6">${reply}</div>`;
        logs.scrollTop = logs.scrollHeight;
      }, 500);
    }
  </script>
</body>

