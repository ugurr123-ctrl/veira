        shrinkBtn.classList.remove('bg-tertiary-container/30', 'text-tertiary');
        isShrunk = false;
      }
    }

    // 3. Action Completion Delight Effect
    function celebrateAction(btn) {
      const toast = document.getElementById('delight-toast');
      const completeText = document.getElementById('complete-text');
      
      btn.disabled = true;
      btn.classList.remove('bg-gradient-to-r', 'from-secondary-container', 'via-secondary', 'to-secondary-fixed');
