      const shrinkBtn = document.getElementById('shrink-btn');
      const shrinkText = document.getElementById('shrink-text');

      if (!isShrunk) {
        textNode.innerHTML = '<span class="text-secondary font-medium">⚡ Mikro-Odak (5 Dk):</span> Başvuru mektubunun sadece ilk paragrafını aç ve 1 güçlü İtalyanca kelimeyi sarıya boya.';
