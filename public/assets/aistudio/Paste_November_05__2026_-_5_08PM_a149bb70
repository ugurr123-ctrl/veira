<!-- 1. Background WebGL Shader with Stardust & Celestial Twinkles -->
<!-- STITCH_SHADER_START:ANIMATION_115 class="fixed inset-0 w-full h-full pointer-events-none -z-10" -->
<div class="fixed inset-0 w-full h-full pointer-events-none -z-10" style="display:block;">
