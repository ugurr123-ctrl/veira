<script>
  // Interactive Living Orb Logic (Haptic vibration & breathing pulse expansion)
  const orbTrigger = document.getElementById('neuralOrbTrigger');
  const orbAura = document.getElementById('orbAura');
  const pulseRipple = document.getElementById('pulseRipple');

  if (orbTrigger && orbAura && pulseRipple) {
    const triggerResonance = () => {
      // Pulse animation trigger
      orbAura.classList.remove('opacity-65', 'blur-2xl');
      orbAura.classList.add('opacity-100', 'blur-3xl', 'scale-125');
      
      pulseRipple.classList.remove('scale-0', 'opacity-0');
      pulseRipple.classList.add('scale-150', 'opacity-80');

      if (navigator.vibrate) {
        navigator.vibrate([25, 45, 25]);
      }

      setTimeout(() => {
        orbAura.classList.add('opacity-65', 'blur-2xl');
        orbAura.classList.remove('opacity-100', 'blur-3xl', 'scale-125');
        
        pulseRipple.classList.add('scale-0', 'opacity-0');
        pulseRipple.classList.remove('scale-150', 'opacity-80');
      }, 700);
    };

    orbTrigger.addEventListener('click', triggerResonance);
  }

  // 15-Minute Countdown Micro-interaction
  const timerElem = document.getElementById('countdownTimer');
  let secondsRemaining = 14 * 60 + 58;

  setInterval(() => {
    if (secondsRemaining > 0) {
      secondsRemaining--;
      const mins = Math.floor(secondsRemaining / 60);
      const secs = secondsRemaining % 60;
      if (timerElem) {
        timerElem.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      }
    }
  }, 1000);

  // Micro-Action Completion & Cosmic Seal Celebration
  const completeBtn = document.getElementById('completeActionBtn');
  const confettiOverlay = document.getElementById('confettiOverlay');
  const btnText = document.getElementById('btnText');
  const btnIcon = document.getElementById('btnIcon');

  if (completeBtn && confettiOverlay) {
    completeBtn.addEventListener('click', () => {
      confettiOverlay.classList.remove('opacity-0', 'pointer-events-none');
      confettiOverlay.classList.add('opacity-100');

      if (btnText && btnIcon) {
        btnText.textContent = 'Mühürlendi ✓';
        btnIcon.textContent = 'task_alt';
      }

      completeBtn.classList.remove('from-primary-container', 'via-[#6f00be]', 'to-[#b38600]');
      completeBtn.classList.add('from-tertiary-container', 'to-[#f5d061]');

      if (navigator.vibrate) {
        navigator.vibrate([60, 40, 120]);
      }

      setTimeout(() => {
        confettiOverlay.classList.add('opacity-0', 'pointer-events-none');
        confettiOverlay.classList.remove('opacity-100');
      }, 2400);
    });
  }
</script></main>
