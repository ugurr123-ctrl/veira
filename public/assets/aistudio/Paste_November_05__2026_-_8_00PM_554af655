<span class="w-7 h-7 rounded-full bg-surface-container-highest border border-outline/30 flex items-center justify-center font-headline-sm text-xs text-primary font-bold">♄ 5</span>
<span class="font-label-md text-xs font-bold text-on-surface">Satürn 5. Evde</span>
</div>
<span class="px-2 py-0.2 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-[10px] font-semibold">Yapılandırıcı Odak</span>
</div>
<p class="font-body-sm text-[11px] text-on-surface-variant mb-1.5">
          Disiplinli yaratıcılık: Kaotik fikirleri Como vizyonuna somut şaheserlerle nakşetme.
</p>
<div class="flex items-center justify-between pt-1 text-on-surface-variant font-label-sm text-[10px] border-t border-outline-variant/20">
<span class="flex items-center gap-1">
<span class="material-symbols-outlined text-[13px] text-primary">psychology</span>
            Derin Odaklanma Modu
</span>
<span class="text-primary font-semibold">Uzun Dönem Transit</span>
</div>
</div>
</div>
</div>
</div>
<script>
  (function initAstroMasterpiece() {
    // 1. Canlı ve İnteraktif Zodyak Jiroskopu Dönüş Mekaniği
    const rotor = document.getElementById('astrolabe-rotor');
    const spinStepBtn = document.getElementById('astrolabe-spin-step-btn');
    const coreBtn = document.getElementById('core-orbit-btn');
    let currentAngle = 0;

    function applyRotation(deg, smooth = true) {
      currentAngle += deg;
      if (rotor) {
        rotor.style.transition = smooth ? 'transform 0.85s cubic-bezier(0.16, 1, 0.3, 1)' : 'none';
        rotor.style.transform = `rotate(${currentAngle}deg)`;
      }
    }

    if (spinStepBtn) {
      spinStepBtn.addEventListener('click', () => applyRotation(30));
    }
    if (coreBtn) {
      coreBtn.addEventListener('click', () => applyRotation(45));
    }

    // Dokunmatik Kaydırma (Touch Swipe) ile Zodyak Çarkı Etkileşimi
    const svgChart = document.getElementById('astrolabe-svg');
    if (svgChart) {
      let startX = 0;
      svgChart.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
      }, { passive: true });

      svgChart.addEventListener('touchmove', (e) => {
        const diffX = e.touches[0].clientX - startX;
        if (Math.abs(diffX) > 28) {
          applyRotation(diffX > 0 ? 15 : -15);
          startX = e.touches[0].clientX;
        }
      }, { passive: true });
    }

    // 2. Büyük Üçlü İnteraktif Kartlar & Analiz Panosu Senkronizasyonu
    const tabs = document.querySelectorAll('.big-three-item');
    const detailTitle = document.getElementById('detail-title');
    const detailSub = document.getElementById('detail-sub');
    const detailIcon = document.getElementById('detail-icon');
    const detailBadge = document.getElementById('detail-badge');
    const laserTrine = document.getElementById('laser-polygon-trine');

    const telemetryData = {
      sun: {
        title: "GÜNEŞ ETKİLEŞİMİ AKTİF: BOĞA 10. EV",
        sub: "Zodyak lazeri 10. tepe noktası Midheaven ile rezonansta. Como Gölü Kariyer manifestasyonu tetiklendi.",
        icon: "flare",
        badge: "100% REZONANS",
        stroke: "#ffe05c"
      },
      moon: {
        title: "AY ETKİLEŞİMİ AKTİF: BALIK 4. EV",
        sub: "432Hz Frekans köprüsü devrede. Duygusal sığınak ve içsel Como dinginliği dengeleniyor.",
        icon: "bedtime",
        badge: "96% UYUM",
        stroke: "#00f2fe"
      },
      rising: {
        title: "YÜKSELEN ETKİLEŞİMİ AKTİF: AKREP 1. EV",
        sub: "1. Ev nöral dönüşüm kapısı açık. 15 Dakikalık çelik irade mikro eylemi hizalandı.",
        icon: "change_circle",
        badge: "98% BİYO-HİZALANMA",
        stroke: "#d5baff"
      }
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        
        tabs.forEach(t => {
          t.classList.remove('border-2', 'border-[#ffe05c]', 'shadow-[0_0_20px_rgba(255,224,92,0.35)]', 'bg-surface-container-highest/90');
          t.classList.add('border', 'border-outline-variant/30', 'bg-surface-container-high/60');
          const shimmer = t.querySelector('.gold-shimmer');
          if (shimmer) shimmer.remove();
          const arrow = t.querySelector('.item-arrow');
          if (arrow) {
            arrow.classList.remove('text-[#ffe05c]', 'text-[#00f2fe]', 'text-primary');
            arrow.classList.add('text-on-surface-variant');
          }
        });

        tab.classList.remove('border', 'border-outline-variant/30', 'bg-surface-container-high/60');
        tab.classList.add('border-2', 'border-[#ffe05c]', 'shadow-[0_0_20px_rgba(255,224,92,0.35)]', 'bg-surface-container-highest/90');
        
        const shimmerEl = document.createElement('div');
        shimmerEl.className = 'absolute inset-0 gold-shimmer pointer-events-none opacity-40';
        tab.prepend(shimmerEl);

        const arrow = tab.querySelector('.item-arrow');
        if (arrow) {
          arrow.classList.remove('text-on-surface-variant');
          arrow.classList.add('text-[#ffe05c]');
        }

        const data = telemetryData[target];
        if (data && detailTitle && detailSub && detailIcon) {
          detailTitle.textContent = data.title;
          detailSub.textContent = data.sub;
          detailIcon.textContent = data.icon;
          if (detailBadge) detailBadge.textContent = data.badge;

          if (laserTrine) {
            laserTrine.setAttribute('stroke', data.stroke);
            laserTrine.style.filter = `drop-shadow(0 0 10px ${data.stroke})`;
          }
          applyRotation(30);
        }
      });
    });

    // 3. Günün 15 Dakikalık Görevi: Yıldız Tozu Parçacık Patlaması & Mühürleme
    const sealBtn = document.getElementById('seal-cosmic-btn');
    const sealBtnWrapper = document.getElementById('seal-btn-wrapper');
    const sealIcon = document.getElementById('seal-btn-icon');
    const sealText = document.getElementById('seal-btn-text');
    let isSealed = false;

    function triggerCosmicStardust(x, y) {
      if (!sealBtnWrapper) return;
      const colors = ['#ffe05c', '#00f2fe', '#ffffff', '#ddb7ff', '#ffd369'];
      for (let i = 0; i < 28; i++) {
        const particle = document.createElement('span');
        particle.className = 'stardust-particle';
        const size = Math.random() * 5 + 3;
        particle.style.width = size + 'px';
        particle.style.height = size + 'px';
        particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        particle.style.boxShadow = `0 0 8px ${particle.style.backgroundColor}`;
        particle.style.left = (x || sealBtnWrapper.clientWidth / 2) + 'px';
        particle.style.top = (y || 22) + 'px';

        const angle = Math.random() * Math.PI * 2;
        const dist = Math.random() * 100 + 35;
        const tx = Math.cos(angle) * dist + 'px';
        const ty = Math.sin(angle) * dist + 'px';
        particle.style.setProperty('--tx', tx);
        particle.style.setProperty('--ty', ty);

        sealBtnWrapper.appendChild(particle);
        setTimeout(() => particle.remove(), 1200);
      }
    }

    if (sealBtn) {
      sealBtn.addEventListener('click', (e) => {
        const rect = sealBtn.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const clickY = e.clientY - rect.top;

        if (!isSealed) {
          isSealed = true;
          triggerCosmicStardust(clickX, clickY);
          sealBtn.classList.remove('from-secondary-container', 'via-primary-container', 'to-secondary');
          sealBtn.classList.add('bg-gradient-to-r', 'from-[#006b71]', 'via-[#00dce6]', 'to-[#04f2fe]', 'text-[#002022]');
          sealIcon.textContent = 'task_alt';
          sealText.textContent = '✓ Hizalanma Mühürlendi';
          sealBtn.style.boxShadow = '0 0 34px rgba(4, 242, 254, 0.8), 0 0 16px rgba(255, 224, 92, 0.6)';
        } else {
          isSealed = false;
          sealBtn.classList.remove('from-[#006b71]', 'via-[#00dce6]', 'to-[#04f2fe]', 'text-[#002022]');
          sealBtn.classList.add('from-secondary-container', 'via-primary-container', 'to-secondary', 'text-on-primary');
          sealIcon.textContent = 'verified';
          sealText.textContent = '✦ Göksel Hizalanmayı Mühürle ✦';
          sealBtn.style.boxShadow = '0 0 24px rgba(221, 183, 255, 0.45)';
        }
      });
    }

    // 4. Canlı Geri Sayım Sayacı
    const timerElem = document.getElementById('countdown-timer');
    let totalSeconds = 14 * 60 + 42;
    if (timerElem) {
      setInterval(() => {
        if (totalSeconds > 0) {
          totalSeconds--;
          const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
          const s = (totalSeconds % 60).toString().padStart(2, '0');
          timerElem.textContent = `${m}:${s}`;
        }
      }, 1000);
    }

    // 5. 12-Bant Canlı Solfeggio Frekans Oynatıcısı & Ekolayzır
    const listenBtn = document.getElementById('listen-frequency-btn');
    const listenIcon = document.getElementById('listen-btn-icon');
    const listenLabel = document.getElementById('listen-btn-label');
    const eqContainer = document.getElementById('audio-eq-container');
    const freqSubtitle = document.getElementById('freq-status-subtitle');
    let isPlaying = false;

    if (listenBtn && eqContainer) {
      listenBtn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        if (isPlaying) {
          eqContainer.classList.add('playing');
          listenIcon.textContent = 'pause';
          listenLabel.textContent = 'Durdur';
          listenBtn.classList.add('bg-[#00f2fe]', 'text-[#002022]');
          if (freqSubtitle) freqSubtitle.textContent = '● Canlı Rezonans: 528Hz DNA Onarımı & Sevgi Frekansı';
        } else {
          eqContainer.classList.remove('playing');
          listenIcon.textContent = 'play_arrow';
          listenLabel.textContent = 'Dinle';
          listenBtn.classList.remove('bg-[#00f2fe]', 'text-[#002022]');
          if (freqSubtitle) freqSubtitle.textContent = '432Hz (Dinginlik) ⇄ 528Hz (Dönüşüm)';
        }
      });
    }

    // 6. Dock Menü Etkileşimi
    const dockLinks = document.querySelectorAll('nav a');
    dockLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        dockLinks.forEach(l => {
          l.classList.remove('bg-secondary-container/60', 'border', 'border-[#ffe05c]/60', 'text-[#ffe05c]', 'shadow-[0_0_20px_rgba(255,224,92,0.45)]', 'scale-105');
          l.classList.add('text-on-surface-variant');
        });
        link.classList.remove('text-on-surface-variant');
        link.classList.add('bg-secondary-container/60', 'border', 'border-[#ffe05c]/60', 'text-[#ffe05c]', 'shadow-[0_0_20px_rgba(255,224,92,0.45)]', 'scale-105');
      });
    });
  })();
</script></main><!-- 7. YÜZEN KAPSÜL MENÜ (FLOATING PILL DOCK) --><nav class="fixed bottom-3 left-1/2 -translate-x-1/2 w-[92%] max-w-[400px] z-50 rounded-full bg-surface/90 border border-[#ffe05c]/35 backdrop-blur-2xl shadow-[0_12px_40px_rgba(4,2,12,0.9)] p-1"><div class="grid grid-cols-6 items-center text-center"><a class="flex flex-col items-center justify-center py-1 text-on-surface-variant hover:text-on-surface transition-all rounded-full" data-path="cosmos" href="#"><span class="material-symbols-outlined text-[18px]">stars</span><span class="font-label-sm text-[8px] tracking-wider uppercase font-semibold mt-0.5">Cosmos</span></a><!-- Astro (Aktif Altın Kapsül ve Işıltılı) --><a aria-current="page" class="relative flex flex-col items-center justify-center py-1 text-[#ffe05c] font-extrabold rounded-full bg-secondary-container/60 border border-[#ffe05c]/60 shadow-[0_0_18px_rgba(255,224,92,0.45)] scale-105 transition-all" data-path="astro" href="#"><span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1; filter: drop-shadow(0 0 6px #ffe05c);">planet</span><span class="font-label-sm text-[8px] tracking-wider uppercase mt-0.5">Astro</span></a><a class="flex flex-col items-center justify-center py-1 text-on-surface-variant hover:text-on-surface transition-all rounded-full" data-path="vizyon" href="#"><span class="material-symbols-outlined text-[18px]">visibility</span><span class="font-label-sm text-[8px] tracking-wider uppercase font-semibold mt-0.5">Vizyon</span></a><a class="flex flex-col items-center justify-center py-1 text-on-surface-variant hover:text-on-surface transition-all rounded-full" data-path="432hz" href="#"><span class="material-symbols-outlined text-[18px]">equalizer</span><span class="font-label-sm text-[8px] tracking-wider uppercase font-semibold mt-0.5">432Hz</span></a><a class="flex flex-col items-center justify-center py-1 text-on-surface-variant hover:text-on-surface transition-all rounded-full" data-path="hedefler" href="#"><span class="material-symbols-outlined text-[18px]">flag</span><span class="font-label-sm text-[8px] tracking-wider uppercase font-semibold mt-0.5">Hedefler</span></a><a class="flex flex-col items-center justify-center py-1 text-on-surface-variant hover:text-on-surface transition-all rounded-full" data-path="ayarlar" href="#"><span class="material-symbols-outlined text-[18px]">tune</span><span class="font-label-sm text-[8px] tracking-wider uppercase font-semibold mt-0.5">Ayarlar</span></a></div></nav></body></html>