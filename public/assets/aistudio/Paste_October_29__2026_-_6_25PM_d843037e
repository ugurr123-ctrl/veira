    const btnAudioToggle = document.getElementById('btn-audio-toggle');
    const audioIcon = document.getElementById('audio-icon');

    let currentProgress = 0;
    let progressTimer = null;
    let isRevealed = false;

    const milestones = [
      { at: 0, text: 'Zihinsel mimari hazırlanıyor...' },
      { at: 35, text: 'Nöral frekanslar eşitleniyor...' },
      { at: 70, text: 'Vizyon panosu uyandırılıyor ✨' },
      { at: 100, text: 'Dinginlik alanı açıldı.' }
    ];

    function startProgress() {
      currentProgress = 0;
      isRevealed = false;
      progressFill.style.width = '0%';
      percentLabel.textContent = '0%';

      clearInterval(progressTimer);
      progressTimer = setInterval(() => {
        currentProgress += 1.25;
        if (currentProgress > 100) currentProgress = 100;

        progressFill.style.width = currentProgress + '%';
        percentLabel.textContent = Math.floor(currentProgress) + '%';

        const match = milestones.slice().reverse().find(m => currentProgress >= m.at);
        if (match && statusText.textContent !== match.text) {
          statusText.textContent = match.text;
        }

        if (currentProgress >= 100) {
          clearInterval(progressTimer);
          setTimeout(revealDashboard, 400);
        }
      }, 35);
    }

    function revealDashboard() {
      if (isRevealed) return;
      isRevealed = true;
      clearInterval(progressTimer);

      // Fade out Splash
      splashLayer.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
      setTimeout(() => {
        splashLayer.classList.add('hidden');
        
        // Reveal Dashboard & Floating Dock
        dashboardLayer.classList.remove('hidden', 'opacity-0', 'pointer-events-none', 'translate-y-6');
        dashboardLayer.classList.add('opacity-100', 'translate-y-0');

        dockBar.classList.remove('opacity-0', 'pointer-events-none');
        dockBar.classList.add('opacity-100');
      }, 500);
    }

    function replaySplash() {
      // Hide Dashboard & Dock
      dashboardLayer.classList.add('opacity-0', 'pointer-events-none', 'translate-y-6');
      dashboardLayer.classList.remove('opacity-100', 'translate-y-0');
      dockBar.classList.add('opacity-0', 'pointer-events-none');
      dockBar.classList.remove('opacity-100');

      setTimeout(() => {
        dashboardLayer.classList.add('hidden');
        splashLayer.classList.remove('hidden');
        
        requestAnimationFrame(() => {
          splashLayer.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
          splashLayer.classList.add('opacity-100', 'scale-100');
          startProgress();
        });
      }, 400);
    }

    btnEnterInstant.addEventListener('click', revealDashboard);
    btnReplaySplash.addEventListener('click', replaySplash);

    // Audio Play/Pause simulation
    let isPlaying = false;
    btnAudioToggle.addEventListener('click', () => {
      isPlaying = !isPlaying;
      audioIcon.textContent = isPlaying ? 'pause' : 'play_arrow';
    });

    // Ambient Stardust Canvas Particles
    const canvas = document.getElementById('veira-stardust-canvas');
    const ctx = canvas.getContext('2d');
    let particles = [];
    let animationFrameId;

    function resizeCanvas() {
      canvas.width = canvas.parentElement.offsetWidth;
      canvas.height = window.innerHeight;
      initParticles();
    }

    function initParticles() {
      particles = [];
      const particleCount = 45;
      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          radius: Math.random() * 1.5 + 0.4,
          speedY: -(Math.random() * 0.35 + 0.1),
          speedX: (Math.random() - 0.5) * 0.2,
          alpha: Math.random() * 0.6 + 0.2,
          pulse: Math.random() * 0.02 + 0.01,
          color: Math.random() > 0.4 ? '#e7c355' : '#c0c1ff'
        });
      }
    }

    function renderParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.y += p.speedY;
        p.x += p.speedX;
        p.alpha += Math.sin(Date.now() * 0.002) * p.pulse;

        if (p.y < 0) p.y = canvas.height;
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = Math.max(0.1, Math.min(0.8, p.alpha));
        ctx.shadowBlur = 6;
        ctx.shadowColor = p.color;
        ctx.fill();
        ctx.shadowBlur = 0;
      });
      animationFrameId = requestAnimationFrame(renderParticles);
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();
    renderParticles();

    // Initiate Progress Run
    startProgress();
  })();
</script></main></body></html>