<!-- Interactive Vision Board Script -->
<script>
    (function initVisionBoard() {
      // Data registry for cards
      const visionDetails = {
        '1': {
          title: 'Como Gölü Kıyısında Yaşam & Çalışma',
          category: 'Kariyer & Bolluk',
          why: 'Aileme ve kendime özgür, zaman kısıtlamalarından arınmış dingin bir yaşam alanı sunmak.',
          action: 'Vize gereksinimleri ve Como bölgesindeki sakin çalışma mekanları listesinden 1 makale oku.',
          shortAction: 'Como çalışma rehberine hızlıca 5 dk göz at ve 1 not al.'
        },
        '2': {
          title: 'Beden & Zihin Dinginliği',
          category: 'Beden & Canlılık',
          why: 'Fiziksel gerginliklerden arınarak her güne yüksek hücresel enerjiyle başlamak.',
          action: 'Akşam yatmadan önce 20 dakika omurga açıcı sakin Yin Yoga akışını tamamla.',
          shortAction: '3 derin nefes egzersizi ve 5 dk omuz esnetmesi yap.'
        },
        '3': {
          title: '432Hz Derin Meditasyon & Şifa',
          category: 'Ruhsal Denge',
          why: 'Zihinsel gevezeliği susturmak ve içsel sezgileri berraklaştırmak.',
          action: 'Kulaklıkları tak, 432Hz kristal kase frekansını aç ve 15 dk sessizce nefesine odaklan.',
          shortAction: '5 dakika boyunca gözlerini kapatıp 432Hz akorunu hisset.'
        },
        '4': {
          title: 'Özgür Dünya Rotaları',
          category: 'Seyahat',
          why: 'Yeni coğrafyaların ve kültürlerin vizyonumu ve ufkumu genişletmesine alan açmak.',
          action: 'İtalya veya İsviçre tren güzergahları için 1 rota taslağını kaydet.',
          shortAction: 'Görmek istediğin 1 göl kenarı kasabasını haritaya iğnele.'
        },
        '5': {
          title: 'Yaratıcı Tasarım Stüdyosu',
          category: 'Kariyer & Bolluk',
          why: 'Kendi vizyonumu yansıtan estetik ve derin projeler inşa etmek.',
          action: 'Kişisel portföyüne en güvendiğin 1 projeyi ekle veya metnini güncelle.',
          shortAction: 'Portföy başlığını ve anahtar niyet cümleni yeniden yaz.'
        },
        '6': {
          title: 'Sıcak Sevgi & Aile Bağı',
          category: 'Ruhsal Denge',
          why: 'En büyük gücümün ve huzurumun sevdiklerimle paylaşılan anlardan beslendiğini hatırlamak.',
          action: 'Ailenden ya da değer verdiğin bir dostundan birine samimi bir şükran mesajı gönder.',
          shortAction: 'Sevdiğin birine seni düşündüm mesajı at.'
        },
        '7': {
          title: 'Finansal Özgürlük & Bolluk',
          category: 'Kariyer & Bolluk',
          why: 'Para stresinden uzaklaşarak niyetlerimi hayata geçirecek maddi güvenceyi büyütmek.',
          action: 'Bu ayki pasif gelir ve birikim dağılımını 15 dakika boyunca çizelgene işle.',
          shortAction: 'Bugünkü harcamalarını kaydet ve bütçeni kontrol et.'
        },
        '8': {
          title: 'Sanatsal Üretim & Yazarlık',
          category: 'Beden & Canlılık',
          why: 'Duygularımı ve fikirlerimi kalıcı birer esere dönüştürmenin hazzını yaşamak.',
          action: 'Herhangi bir filtre uygulamadan 2 tam sayfa serbest bilinç akışı günlüğü yaz.',
          shortAction: 'Bugün hissettiğin en güçlü duyguyu 3 cümleyle özetle.'
        }
      };

      let activeCardId = '1';

      // Elements
      const sheet = document.getElementById('actionBottomSheet');
      const sheetContent = document.getElementById('modalSheetContent');
      const closeBtn = document.getElementById('closeModalBtn');
      const completeBtn = document.getElementById('completeModalActionBtn');
      const shrinkBtn = document.getElementById('shrinkAiBtn');
      const toast = document.getElementById('toastMessage');
      const toastText = document.getElementById('toastText');

      function showToast(msg) {
        if (!toast) return;
        toastText.textContent = msg;
        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 2400);
      }

      function openModal(id) {
        activeCardId = id;
        const data = visionDetails[id] || visionDetails['1'];
        document.getElementById('modalTitle').textContent = data.title;
        document.getElementById('modalCategory').textContent = data.category;
        document.getElementById('modalWhy').innerHTML = '&ldquo;' + data.why + '&rdquo;';
        document.getElementById('modalActionText').textContent = data.action;

        sheet.classList.remove('opacity-0', 'pointer-events-none');
        sheetContent.classList.remove('translate-y-full');
      }

      function closeModal() {
        sheetContent.classList.add('translate-y-full');
        sheet.classList.add('opacity-0', 'pointer-events-none');
      }

      // Filter handling
      const filterBtns = document.querySelectorAll('.category-filter-btn');
      const cards = document.querySelectorAll('[data-category-item]');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category');
          
          filterBtns.forEach(b => {
            b.classList.remove('bg-secondary', 'text-on-secondary', 'font-semibold');
            b.classList.add('bg-surface-container-high/80', 'text-on-surface-variant');
          });
          btn.classList.add('bg-secondary', 'text-on-secondary', 'font-semibold');
          btn.classList.remove('bg-surface-container-high/80', 'text-on-surface-variant');

          cards.forEach(card => {
            const itemCat = card.getAttribute('data-category-item');
            if (cat === 'all' || itemCat === cat) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // Card click opens modal
      document.querySelectorAll('.vision-card').forEach(card => {
        card.addEventListener('click', (e) => {
          // If clicked directly on the check button, don't open modal
          if (e.target.closest('.check-action-btn')) return;
          const id = card.getAttribute('data-card-id');
          if (id) openModal(id);
        });
      });

      // Explicit modal triggers
      document.querySelectorAll('[data-open-modal]').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = trigger.getAttribute('data-open-modal');
          openModal(id);
        });
      });

      // Checkbox click toggle
      document.querySelectorAll('.check-action-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-check-trigger');
          toggleCheck(id, btn);
        });
      });

      function toggleCheck(id, btnElement) {
        const icon = btnElement.querySelector('.status-icon');
        const isDone = btnElement.classList.contains('bg-secondary');

        if (!isDone) {
          btnElement.classList.remove('bg-surface-container-lowest/80');
          btnElement.classList.add('bg-secondary');
          if (icon) {
            icon.textContent = 'check_circle';
            icon.classList.remove('text-on-surface-variant');
            icon.classList.add('text-on-secondary');
          }
          showToast('Tebrikler! Günlük niyet eylemi tamamlandı ✨');
        } else {
          btnElement.classList.add('bg-surface-container-lowest/80');
          btnElement.classList.remove('bg-secondary');
          if (icon) {
            icon.textContent = 'radio_button_unchecked';
            icon.classList.add('text-on-surface-variant');
            icon.classList.remove('text-on-secondary');
          }
        }
      }

      // Modal completion button
      if (completeBtn) {
        completeBtn.addEventListener('click', () => {
          const targetBtn = document.querySelector(`[data-check-trigger="${activeCardId}"]`);
          if (targetBtn) {
            targetBtn.classList.remove('bg-surface-container-lowest/80');
            targetBtn.classList.add('bg-secondary');
            const icon = targetBtn.querySelector('.status-icon');
            if (icon) {
              icon.textContent = 'check_circle';
              icon.classList.remove('text-on-surface-variant');
              icon.classList.add('text-on-secondary');
            }
          }
          closeModal();
          showToast('15 Dakikalık eylem tamamlandı. Yıldız parıldıyor!');
        });
      }

      // AI Shrink micro-action
      if (shrinkBtn) {
        shrinkBtn.addEventListener('click', () => {
          const data = visionDetails[activeCardId];
          if (data && data.shortAction) {
            document.getElementById('modalActionText').textContent = data.shortAction;
            showToast('AI eylemi 5 dakikaya sadeleştirdi ⚡');
          }
        });
      }

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (sheet) {
        sheet.addEventListener('click', (e) => {
          if (e.target === sheet) closeModal();
        });
      }

      // Wallpaper export button
      const wallpaperBtn = document.getElementById('wallpaperExportBtn');
      if (wallpaperBtn) {
        wallpaperBtn.addEventListener('click', () => {
          showToast('4K Kilit Ekranı Duvar Kağıdı Hazırlanıyor... 📱');
        });
      }

      // Add Vision Card button
      const addCardBtn = document.getElementById('addVisionCardBtn');
      if (addCardBtn) {
        addCardBtn.addEventListener('click', () => {
          showToast('Maksimum 12 görsel sınırında 8/12 alandasınız.');
        });
      }

      // Year selector prompt
      const yearBtn = document.getElementById('yearSelectorBtn');
      if (yearBtn) {
        yearBtn.addEventListener('click', () => {
          showToast('2027 Vizyon döngüsü aktif.');
        });
      }

