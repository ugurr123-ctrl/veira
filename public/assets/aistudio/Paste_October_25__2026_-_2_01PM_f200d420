<!-- INTERACTION JAVASCRIPT -->
<script>
  function openPhotoSheet() {
    const modal = document.getElementById('photoActionSheetModal');
    const content = document.getElementById('sheetContent');
    modal.classList.remove('pointer-events-none', 'opacity-0');
    modal.classList.add('opacity-100');
    content.classList.remove('translate-y-full');
    content.classList.add('translate-y-0');
  }

  function closePhotoSheet() {
    const modal = document.getElementById('photoActionSheetModal');
    const content = document.getElementById('sheetContent');
    content.classList.remove('translate-y-0');
    content.classList.add('translate-y-full');
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    setTimeout(() => {
      modal.classList.add('pointer-events-none');
      closeCameraPreview();
    }, 300);
  }

  function triggerFilePicker() {
    document.getElementById('realPhotoInput').click();
  }

  function handleFileSelected(event) {
    const file = event.target.files && event.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        updateMainAvatar(e.target.result);
        closePhotoSheet();
        showAuraToast('Profil auran galeriden başarıyla yüklendi ✨');
      };
      reader.readAsDataURL(file);
    }
  }

  function triggerInstantCamera() {
    const cameraBox = document.getElementById('cameraViewfinder');
    cameraBox.classList.remove('hidden');
    cameraBox.classList.add('flex');
  }

  function closeCameraPreview() {
    const cameraBox = document.getElementById('cameraViewfinder');
    cameraBox.classList.remove('flex');
    cameraBox.classList.add('hidden');
  }

  function captureSimulatedShot() {
    // Cinematic instant portrait capture
    const shotUrl = 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80';
    updateMainAvatar(shotUrl);
    closeCameraPreview();
    closePhotoSheet();
    showAuraToast('Anlık çekim auranızla birleştirildi ✨');
  }

  function setAvatarPreset(url, name) {
    updateMainAvatar(url);
    closePhotoSheet();
    showAuraToast(name + ' aurası aktive edildi ✨');
  }

  function updateMainAvatar(newSrc) {
    const avatar = document.getElementById('mainAvatarImage');
    avatar.style.opacity = '0';
    setTimeout(() => {
      avatar.src = newSrc;
      avatar.style.opacity = '1';
    }, 150);
  }

  function showAuraToast(text) {
    const toast = document.getElementById('auraToast');
    const msg = document.getElementById('toastMessage');
    if (text) msg.textContent = text;
    
    toast.classList.remove('opacity-0', '-translate-y-4');
    toast.classList.add('opacity-100', 'translate-y-0');
    
    setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', '-translate-y-4');
    }, 3200);
  }
</script>
