<script>
  // Category Selector Interactive Toggling
  const categoryContainer = document.getElementById('wheel-category-selector');
  if (categoryContainer) {
    const buttons = categoryContainer.querySelectorAll('.wheel-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('bg-surface-container-high', 'shadow-md');
          b.classList.add('bg-surface-container-low');
          const title = b.querySelector('.text-title-md');
          if (title) {
            title.classList.remove('text-secondary');
            title.classList.add('text-on-surface');
          }
          const icon = b.querySelector('.w-9');
          if (icon) {
            icon.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-[0_0_12px_rgba(231,195,85,0.4)]');
            icon.classList.add('bg-surface-container-highest');
          }
          const check = b.querySelector('.check-indicator');
          if (check) check.remove();
        });

        // Activate selected
        btn.classList.remove('bg-surface-container-low');
        btn.classList.add('bg-surface-container-high', 'shadow-md');
        const title = btn.querySelector('.text-title-md');
        if (title) {
          title.classList.remove('text-on-surface');
          title.classList.add('text-secondary');
        }
        const icon = btn.querySelector('.w-9');
        if (icon) {
          icon.classList.remove('bg-surface-container-highest');
          icon.classList.add('bg-secondary', 'text-on-secondary', 'shadow-[0_0_12px_rgba(231,195,85,0.4)]');
        }

        const checkMark = document.createElement('span');
        checkMark.className = 'check-indicator material-symbols-outlined text-secondary text-[18px] absolute right-3';
        checkMark.style.fontVariationSettings = "'FILL' 1";
        checkMark.textContent = 'check_circle';
        btn.appendChild(checkMark);
      });
    });
  }

  // Micro-Action Shrink Interaction (Resistance-Free Step)
  const shrinkBtn = document.getElementById('shrink-action-btn');
  const microActionText = document.getElementById('micro-action-text');
  let isShrunk = false;

  if (shrinkBtn && microActionText) {
    shrinkBtn.addEventListener('click', () => {
      isShrunk = !isShrunk;
      if (isShrunk) {
        microActionText.textContent = "Sadece İtalyanca vize başvuru sitesini tarayıcında sekme olarak aç ve kapat (1-2 dakika).";
        shrinkBtn.innerHTML = '<span class="material-symbols-outlined text-[15px]">undo</span><span>15 Dk\\'ya Döndür</span>';
        shrinkBtn.classList.add('bg-secondary', 'text-on-secondary');
      } else {
        microActionText.textContent = "Vize portföyünden 1 ilham yazısı oku ve 3 anahtar kelime not al.";
        shrinkBtn.innerHTML = '<span class="material-symbols-outlined text-[15px]">compress</span><span>⚡ 5 Dk\\'ya Küçült</span>';
        shrinkBtn.classList.remove('bg-secondary', 'text-on-secondary');
      }
    });
  }
</script></main></body></html>