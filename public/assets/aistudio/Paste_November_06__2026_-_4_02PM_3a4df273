<!-- Stardust Particles & Chart Interactivity Script -->
<script>
  // 1. Cosmic Stardust Canvas Layer
  (function initCosmicStardust() {
    const canvas = document.getElementById('stardustCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width, height;
    let particles = [];

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    const colors = [
      'rgba(245, 208, 97, ',  // Gold
      'rgba(213, 186, 255, ', // Lavender
      'rgba(0, 220, 230, ',   // Celestial Cyan
      'rgba(255, 255, 255, '  // Silver
    ];

    for (let i = 0; i < 48; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 1.6 + 0.4,
        colorPrefix: colors[Math.floor(Math.random() * colors.length)],
        alpha: Math.random() * 0.7 + 0.2,
        speedX: (Math.random() - 0.5) * 0.25,
        speedY: (Math.random() - 0.5) * 0.25,
        pulseSpeed: 0.015 + Math.random() * 0.02
      });
    }

    function render() {
      ctx.clearRect(0, 0, width, height);
      for (let i = 0; i < particles.length; i++) {
        let p = particles[i];
        p.x += p.speedX;
        p.y += p.speedY;

        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        p.alpha += Math.sin(Date.now() * 0.002 * p.pulseSpeed) * 0.01;
        let clampedAlpha = Math.max(0.15, Math.min(0.85, p.alpha));

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.colorPrefix + clampedAlpha + ')';
        ctx.shadowBlur = 6;
        ctx.shadowColor = p.colorPrefix + '0.8)';
        ctx.fill();
      }
      requestAnimationFrame(render);
    }
    render();
  })();

  // 2. Natal Chart & Accordion Interactive Controllers
  (function initInteractions() {
    let rotationDegree = 0;
    const wheelSvg = document.getElementById('natalWheelSvg');
    const rotateBtn = document.getElementById('rotateWheelBtn');
    const toggleAspectsBtn = document.getElementById('toggleAspectsBtn');

    if (rotateBtn && wheelSvg) {
      rotateBtn.addEventListener('click', () => {
        rotationDegree += 60;
        wheelSvg.style.transform = `rotate(${rotationDegree}deg)`;
      });
    }

    if (toggleAspectsBtn) {
      let aspectsVisible = true;
      const aspectLayer = document.getElementById('aspectLayer');
      toggleAspectsBtn.addEventListener('click', () => {
        aspectsVisible = !aspectsVisible;
        if (aspectLayer) {
          aspectLayer.style.display = aspectsVisible ? 'block' : 'none';
        }
        toggleAspectsBtn.classList.toggle('opacity-60');
      });
    }

    // Accordions in Section 04
    const cards = document.querySelectorAll('.planet-card');
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const details = card.querySelector('.planet-details');
        const chevron = card.querySelector('.chevron');
        const isExpanded = card.classList.contains('expanded');

        if (isExpanded) {
          card.classList.remove('expanded');
          if (details) details.classList.add('hidden');
          if (chevron) chevron.style.transform = 'rotate(0deg)';
        } else {
          card.classList.add('expanded');
          if (details) details.classList.remove('hidden');
          if (chevron) chevron.style.transform = 'rotate(180deg)';
        }
      });
    });
  })();
</script>
