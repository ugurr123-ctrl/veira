<script>
  (function initNatalInteractions() {
    let rotationDegree = 0;
    const wheelSvg = document.getElementById('natalWheelSvg');
    const rotateBtn = document.getElementById('rotateWheelBtn');
    const toggleAspectsBtn = document.getElementById('toggleAspectsBtn');
    const explainModeBtn = document.getElementById('explainModeBtn');

    if (rotateBtn && wheelSvg) {
      rotateBtn.addEventListener('click', () => {
        rotationDegree = (rotationDegree + 30) % 360;
        wheelSvg.style.transform = `rotate(${rotationDegree}deg)`;
      });
    }

    if (toggleAspectsBtn && wheelSvg) {
      let aspectsVisible = true;
      toggleAspectsBtn.addEventListener('click', () => {
        aspectsVisible = !aspectsVisible;
        const aspectPolygon = wheelSvg.querySelector('polygon');
        const aspectLines = wheelSvg.querySelectorAll('line[stroke*="url"], line[stroke-dasharray="3 3"]');
        
        if (aspectPolygon) {
          aspectPolygon.style.display = aspectsVisible ? 'block' : 'none';
        }
        aspectLines.forEach(line => {
          line.style.display = aspectsVisible ? 'block' : 'none';
        });
        
        toggleAspectsBtn.classList.toggle('opacity-60');
      });
    }

    if (explainModeBtn) {
      explainModeBtn.addEventListener('click', () => {
        const cards = document.querySelectorAll('.planet-card');
        const anyExpanded = Array.from(cards).some(c => c.classList.contains('expanded'));
        cards.forEach(card => {
          if (anyExpanded) {
            card.classList.remove('expanded');
          } else {
            card.classList.add('expanded');
          }
        });
      });
    }

    // Toggle behavior styling hook
    const styleHook = document.createElement('style');
    styleHook.textContent = `
      .planet-card.expanded .planet-details { display: block !important; }
      .planet-card.expanded .chevron { transform: rotate(180deg); color: #d5baff; }
    `;
